SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://127.0.0.1:6379/1

# Prints emails to the console by default. To send real email via Gmail SMTP,
# set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend, EMAIL_HOST=
# smtp.gmail.com, and use a Gmail App Password (not your account password) for
# EMAIL_HOST_PASSWORD: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
